{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "audit": "pnpm audit --prod --audit-level high",
    "perf": "next build && lhci autorun",
    "prepare": "husky",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@vercel/analytics": "^1.5.0",
    "animejs": "^4.2.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.17",
    "next": "16.3.8",
    "postprocessing": "^6.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.180.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@size-limit/preset-app": "^14.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "3.9.9",
    "size-limit": "^14.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  },
  "size-limit": [
    {
      "name": "initial route JS",
      "path": ".next/static/chunks/app/page-*.js",
      "limit": "180 KB"
    },
    {
      "name": "lazy 3D chunk",
      "path": ".next/static/chunks/**/*.js",
      "limit": "650 KB"
    }
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
